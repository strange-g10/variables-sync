# Environment Variables
# Copy this file to .env and fill in your actual values

# Figma Personal Access Token (PAT)
# For Organization accounts: Get it from Figma Organization settings
# Individual accounts: Get it from https://www.figma.com/developers/api#access-tokens
# Organization PAT provides enhanced permissions and higher rate limits
FIGMA_TOKEN=your_figma_organization_pat_here

# Google Sheets credentials file path
# Download from Google Cloud Console > APIs & Services > Credentials
# Create a Service Account and download the JSON key file
GOOGLE_CREDENTIALS_FILE=./credentials.json

# Optional: Custom configuration paths
# CONFIG_PATH=./config/custom_config.json
# LOG_LEVEL=INFO
