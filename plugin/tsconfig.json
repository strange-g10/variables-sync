{
    "compilerOptions": {
      "target": "es6",
      "lib": ["es6", "dom"],
      "strict": true,
      "module": "esnext",
      "moduleResolution": "node",
      "outDir": "./dist",
      "typeRoots": ["./node_modules/@types", "./node_modules/@figma"],
      "esModuleInterop": true,
      "skipLibCheck": true,
      "sourceMap": true
    },
    "include": ["src/**/*", "src/ui/**/*"],
    "exclude": ["node_modules"]
  }