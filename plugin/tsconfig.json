{
    "compilerOptions": {
      "target": "es2019",
      "lib": ["es2019", "dom"],
      "strict": true,
      "module": "esnext",
      "moduleResolution": "node",
      "outDir": "./dist",
      "typeRoots": ["./node_modules/@types"],
      "esModuleInterop": true,
      "skipLibCheck": true,
      "sourceMap": true
    },
    "include": ["src/**/*", "src/ui/**/*"],
    "exclude": ["node_modules"]
  }
